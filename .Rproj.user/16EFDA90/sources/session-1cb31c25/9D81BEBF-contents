import yfinance as yf
from fredapi import Fred
import pandas as pd
import numpy as np
import os

# Create a local directory to store CSV files to document a reproducible workflow
os.makedirs("data", exist_ok=True)

# 1. Fetch Market Data via Yahoo Finance
# Assets requested: SPY, QQQ, BTC-USD, ETH-USD, IBIT, FBTC, ARKB
tickers = ["SPY", "QQQ", "BTC-USD", "ETH-USD", "IBIT", "FBTC", "ARKB"]
print("Downloading Yahoo Finance market data...")

# Download adjusted closing prices (returns require adjusted data to account for dividends/splits)
market_data = yf.download(tickers, start="2020-01-01", end="2026-11-01")['Adj Close']

# Save raw market data as a CSV file
market_data.to_csv("data/raw_yfinance_market_data.csv")

# 2. Fetch Macroeconomic Data via FRED
# NOTE: You must register for a free FRED API key and replace the placeholder below
try:
    fred = Fred(api_key='YOUR_FRED_API_KEY')
    print("Downloading FRED macroeconomic data...")
    
    # Retrieve SOFR and 1-Year Treasury Constant Maturity Rate
    sofr = fred.get_series('SOFR')
    treasury = fred.get_series('DGS1') 
    
    fred_data = pd.DataFrame({'SOFR': sofr, 'Treasury_1Y': treasury})
    
    # Save raw macroeconomic data as a CSV file
    fred_data.to_csv("data/raw_fred_macro_data.csv")
except ValueError:
    print("FRED API key missing or invalid. Skipping macroeconomic data download.")
    fred_data = pd.DataFrame()

# 3. Clean Data and Align Calendars
print("Aligning calendars and computing returns...")

# Establish the 5-day equity calendar by dropping non-trading days (NaNs) from SPY
equity_calendar = market_data['SPY'].dropna().index

# Resample the 7-day crypto assets and standard equities strictly to the 5-day calendar
cleaned_market_data = market_data.reindex(equity_calendar)

# Merge macroeconomic data onto the same 5-day equity calendar if available
if not fred_data.empty:
    cleaned_fred_data = fred_data.reindex(equity_calendar)
    final_dataset = pd.concat([cleaned_market_data, cleaned_fred_data], axis=1)
else:
    final_dataset = cleaned_market_data

# Compute the daily returns dataset required for Sharpe, Sortino, and CAPM beta estimation
returns_dataset = final_dataset.pct_change().dropna()

# Save the final cleaned price and return datasets as CSV files
final_dataset.to_csv("data/cleaned_price_dataset.csv")
returns_dataset.to_csv("data/cleaned_return_dataset.csv")

print("Data generation complete. All files have been saved to the 'data' folder.")