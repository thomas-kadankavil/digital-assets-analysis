#!/usr/bin/env Rscript
# public_data_extractor.R
# =======================
# A reusable toolkit for extracting data from public REST APIs and file
# endpoints in R. Mirrors the companion Python script and features:
#
#   1. HTTP client with automatic rate-limit handling (HTTP 429/503,
#      Retry-After headers, exponential backoff with jitter, client-side
#      throttling, per-request timeout).
#   2. Pagination for the four common REST styles:
#        - page-number   (?page=2&per_page=100)
#        - offset-limit  (?offset=0&limit=100)
#        - cursor/token  (opaque cursor returned by each response)
#        - link-header   (GitHub-style Link: <...>; rel="next")
#   3. JSON parsing into data.tables (nested-record flattening) with
#      jsonlite, and fast CSV parsing with data.table::fread (local paths
#      and URLs), including newline-delimited JSON (JSONL).
#   4. Batch downloading of remote files to local storage with retries,
#      skip-if-exists, parallel workers on unix, and a manifest table.
#
# Requirements: install.packages(c("httr2", "jsonlite", "data.table"))
#
# Usage as a library:
#   source("public_data_extractor.R")
#   client <- make_client("https://api.example.com")
#   dt     <- paginate(client, "/items", style = "page")
#
# Run as a script for a live demonstration against public sources:
#   Rscript public_data_extractor.R [--out-dir data] [--verbose]

suppressPackageStartupMessages({
  library(httr2)
  library(jsonlite)
  library(data.table)
})

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

.extractor_loglevel <- "info"

set_log_level <- function(level = c("debug", "info", "error")) {
  .extractor_loglevel <<- match.arg(level)
}

log_debug <- function(fmt, ...) if (.extractor_loglevel == "debug")
  message(sprintf("D %s", sprintf(fmt, ...)))
log_info  <- function(fmt, ...) if (.extractor_loglevel %in% c("debug", "info"))
  message(sprintf("I %s", sprintf(fmt, ...)))
log_warn  <- function(fmt, ...) message(sprintf("W %s", sprintf(fmt, ...)))

# ---------------------------------------------------------------------------
# 1. HTTP client with rate-limit / retry handling
# ---------------------------------------------------------------------------

#' Build an API client (closure-based).
#'
#' @param base_url           Root URL for relative paths ("" = full URLs only).
#' @param headers            Named list of default headers (auth, API keys...).
#' @param default_params     Named list of query parameters sent with every
#'                           request.
#' @param timeout_seconds    Per-request timeout; requests never hang forever.
#' @param max_retries        Retries for 429/5xx and network errors.
#' @param backoff_base       Exponential backoff base; sleep is
#'                           backoff_base^(2^attempt) seconds with full jitter,
#'                           capped at backoff_cap.
#' @param min_interval       Client-side rate limit: minimum seconds between
#'                           requests (politeness throttle).
make_client <- function(base_url = "",
                        headers = list(),
                        default_params = list(),
                        timeout_seconds = 30,
                        max_retries = 5,
                        backoff_base = 1.5,
                        backoff_cap = 60,
                        min_interval = 0) {
  stopifnot(is.character(base_url), is.numeric(timeout_seconds))

  base <- sub("/+$", "", base_url)
  last_request_time <- -Inf
  ua <- "public-data-extractor-R/1.0"

  absolutize <- function(path_or_url) {
    if (grepl("^https?://", path_or_url)) return(path_or_url)
    if (!nzchar(base)) stop("Relative path given but no base_url configured")
    paste0(base, "/", sub("^/+", "", path_or_url))
  }

  throttle <- function() {
    if (min_interval <= 0) return(invisible())
    elapsed <- proc.time()[["elapsed"]] - last_request_time
    if (elapsed < min_interval) {
      log_debug("Throttling: sleeping %.2fs", min_interval - elapsed)
      Sys.sleep(min_interval - elapsed)
    }
    last_request_time <<- proc.time()[["elapsed"]]
  }

  # Retry-After (seconds or HTTP-date) with exponential backoff + jitter.
  compute_delay <- function(resp, attempt) {
    retry_after <- NULL
    if (!is.null(resp)) {
      raw <- resp_headers(resp)$`retry-after` %||% NULL
      if (!is.null(raw)) {
        val <- suppressWarnings(as.numeric(raw))
        if (is.na(val)) {                 # HTTP-date form
          when <- as.POSIXct(raw, tz = "UTC")
          if (!is.na(when))
            val <- max(0, as.numeric(when - Sys.time(), units = "secs"))
        }
        retry_after <- if (!is.na(val)) val else NULL
      }
    }
    if (is.null(retry_after)) {
      backoff <- min(backoff_cap, backoff_base^(2^attempt))
      retry_after <- runif(1, 0, backoff)          # full jitter
    }
    min(retry_after, 120)
  }

  is_transient <- function(resp) {
    status <- resp_status(resp)
    status %in% c(429L, 500L, 502L, 503L, 504L)    # rate limit / transient
  }

  # Exponential backoff with full jitter; httr2 calls this once per retry
  # with the failed response, so a closure counter supplies the attempt.
  retry_count <- 0L
  backoff_fn <- function(resp) {
    retry_count <<- retry_count + 1L
    min(backoff_cap, stats::runif(1, 0, backoff_base^(2^(retry_count - 1L))))
  }

  # Build a configured httr2 request (retry + throttle are added here, so
  # every GET through the client inherits rate-limit handling).
  build_request <- function(path_or_url, params = list()) {
    throttle()
    url <- absolutize(path_or_url)
    req <- request(url) |>
      req_user_agent(ua) |>
      req_timeout(timeout_seconds) |>
      req_headers(!!!headers) |>
      req_url_query(!!!default_params)
    if (length(params)) req <- req |> req_url_query(!!!params)
    req |>
      req_retry(
        max_tries = max_retries + 1L,
        backoff = backoff_fn,
        is_transient = is_transient,
        after = function(resp) {
          log_warn("HTTP %s; retrying (Retry-After: %ss)",
                   resp_status(resp),
                   resp_headers(resp)$`retry-after` %||% "n/a")
          NA_real_   # defer to the backoff/Retry-After computation
        }
      )
  }

  # Outer retry loop for network-level failures (connection errors,
  # timeouts) with exponential backoff + jitter, mirroring the Python
  # client. HTTP 429/503 handling is already provided by req_retry above.
  perform_with_retries <- function(do_perform, what) {
    for (attempt in seq_len(max_retries + 1L)) {
      result <- tryCatch(
        list(value = do_perform(), error = NULL),
        error = function(e) list(value = NULL, error = e)
      )
      if (is.null(result$error)) return(result$value)
      msg <- conditionMessage(result$error)
      is_network <- grepl("curl|Could not resolve|timed out|Timeout",
                          msg)
      if (!is_network || attempt == max_retries + 1L) stop(result$error)
      delay <- runif(1, 0, min(backoff_cap, backoff_base^(2^(attempt - 1))) )
      log_warn("Network error (%s) on %s; retry %d/%d in %.1fs",
               msg, what, attempt, max_retries, delay)
      Sys.sleep(delay)
    }
  }

  list(
    get = function(path_or_url, params = list(), resp_path = NULL) {
      req <- build_request(path_or_url, params)
      perform_with_retries(function() req_perform(req, path = resp_path),
                           path_or_url)
    },
    get_json = function(path_or_url, params = list()) {
      do_get <- function() {
        req <- build_request(path_or_url, params)
        req_perform(req)
      }
      resp <- perform_with_retries(do_get, path_or_url)
      if (resp_status(resp) >= 400) {
        stop(sprintf("HTTP %s for %s", resp_status(resp), resp_url(resp)),
             call. = FALSE)
      }
      resp_body_json(resp)
    },
    base_url = function() base
  )
}

`%||%` <- function(a, b) if (is.null(a)) b else a

# ---------------------------------------------------------------------------
# 2. Pagination
# ---------------------------------------------------------------------------

#' Best-effort extraction of the record list from a JSON envelope.
#' Handles: bare list, results/data/items/records/docs keys, and one level
#' of nesting under result/response (CKAN style).
records_from_response <- function(payload) {
  if (is.data.frame(payload)) return(payload)      # already tabular
  if (is.list(payload)) {
    if (!is.null(names(payload))) {
      for (key in c("results", "data", "items", "records", "docs")) {
        v <- payload[[key]]
        if (is.null(v)) next
        # A page of records: a data.frame, an unnamed list of records,
        # or an empty list (empty page).
        if (is.data.frame(v)) return(v)
        if (is.list(v) && (is.null(names(v)) || !length(v))) return(v)
      }
      inner <- payload$result %||% payload$response
      if (!is.null(inner) && is.list(inner))
        return(records_from_response(inner))
    } else {
      return(payload)                                # unnamed list of records
    }
  }
  stop("Could not locate record list in payload: ",
       substr(toJSON(payload, auto_unbox = TRUE), 1, 200), call. = FALSE)
}

#' Parse a GitHub-style Link header, returning the rel="next" URL (or NULL).
next_link_from_response <- function(resp) {
  link <- resp_headers(resp)$link
  if (is.null(link)) return(NULL)
  for (part in strsplit(link, ",", fixed = TRUE)[[1]]) {
    segs <- strsplit(part, ";", fixed = TRUE)[[1]]
    if (length(segs) > 1 && grepl('rel="?next"?', segs[-1])) {
      return(gsub("[<>[:space:]]", "", segs[1]))
    }
  }
  NULL
}

#' Collect records across pages into one data.table.
#'
#' @param style       "page" (?page=&per_page=), "offset" (?offset=&limit=),
#'                    "cursor" (opaque token in each response), or "link"
#'                    (GitHub-style Link header).
#' @param page_size   Records per page.
#' @param max_pages   Safety bound on pages fetched (NULL = unbounded).
#' @param sleep_between_pages  Politeness delay between pages.
#' @param records_key Override record auto-detection with an explicit key.
#' @param param names page_param/size_param/offset_param/limit_param/
#'                    cursor_param are configurable per API.
#' @return data.table with all records (rbindlist'd, fill = TRUE).
paginate <- function(client,
                     path,
                     style = c("page", "offset", "cursor", "link"),
                     page_size = 100,
                     max_pages = 10,
                     sleep_between_pages = 0.5,
                     records_key = NULL,
                     page_param = "page",
                     size_param = "per_page",
                     offset_param = "offset",
                     limit_param = "limit",
                     cursor_param = "cursor",
                     next_key = "next",
                     extra_params = list()) {
  style <- match.arg(style)
  batches <- list()
  pages_fetched <- 0
  get_batch <- function(payload) {
    b <- if (is.null(records_key)) records_from_response(payload)
         else payload[[records_key]]
    if (is.data.frame(b)) {
      as.data.table(b)
    } else if (length(b)) {
      json_records_to_dt(b)   # flatten nested records to dotted columns
    } else {
      data.table()                                   # empty page
    }
  }

  if (style == "page") {
    page_num <- 1
    repeat {
      if (!is.null(max_pages) && pages_fetched >= max_pages) break
      params <- c(extra_params, setNames(list(page_num, page_size),
                                         c(page_param, size_param)))
      batch <- get_batch(client$get_json(path, params))
      if (!nrow(batch)) break
      batches[[length(batches) + 1]] <- batch
      pages_fetched <- pages_fetched + 1
      page_num <- page_num + 1
      Sys.sleep(sleep_between_pages)
    }
  } else if (style == "offset") {
    offset <- 0
    repeat {
      if (!is.null(max_pages) && pages_fetched >= max_pages) break
      params <- c(extra_params, setNames(list(offset, page_size),
                                         c(offset_param, limit_param)))
      batch <- get_batch(client$get_json(path, params))
      if (!nrow(batch)) break
      batches[[length(batches) + 1]] <- batch
      pages_fetched <- pages_fetched + 1
      offset <- offset + nrow(batch)
      Sys.sleep(sleep_between_pages)
    }
  } else if (style == "cursor") {
    cursor <- NULL
    repeat {
      if (!is.null(max_pages) && pages_fetched >= max_pages) break
      params <- c(extra_params, setNames(list(page_size), limit_param))
      if (!is.null(cursor))
        params[[cursor_param]] <- cursor
      payload <- client$get_json(path, params)
      batch <- get_batch(payload)
      if (!nrow(batch)) break
      batches[[length(batches) + 1]] <- batch
      pages_fetched <- pages_fetched + 1
      cursor <- if (is.list(payload)) payload[[next_key]] else NULL
      if (is.null(cursor) || !length(cursor) || !nzchar(cursor)) break
      Sys.sleep(sleep_between_pages)
    }
  } else if (style == "link") {
    url <- path
    repeat {
      if (!is.null(max_pages) && pages_fetched >= max_pages) break
      resp <- client$get(url)
      if (resp_status(resp) >= 400)
        stop(sprintf("HTTP %s for %s", resp_status(resp), resp_url(resp)),
             call. = FALSE)
      payload <- resp_body_json(resp)
      batch <- get_batch(payload)
      if (!nrow(batch)) break
      batches[[length(batches) + 1]] <- batch
      pages_fetched <- pages_fetched + 1
      url <- next_link_from_response(resp)
      if (is.null(url)) break
      Sys.sleep(sleep_between_pages)
    }
  }

  out <- if (length(batches))
    rbindlist(batches, fill = TRUE, use.names = TRUE) else data.table()
  log_info("paginate(%s): %d records over %d page(s)", path, nrow(out),
           pages_fetched)
  out
}

# ---------------------------------------------------------------------------
# 3. Parsing helpers (jsonlite + data.table)
# ---------------------------------------------------------------------------

#' Flatten a list of JSON records into a data.table.
#' Nested objects become dotted columns ({"user": {"name": ...}} ->
#' user.name) via jsonlite's flatten, mirroring pandas.json_normalize.
json_records_to_dt <- function(records) {
  if (!length(records)) return(data.table())
  as.data.table(fromJSON(toJSON(records), flatten = TRUE))
}

#' Parse a JSON file into a data.table. Accepts a single JSON document
#' (record list or envelope) or newline-delimited JSON (JSONL), which is
#' what save_outputs() writes.
parse_json_file <- function(path) {
  text <- paste(readLines(path, warn = FALSE), collapse = "\n")
  parsed <- tryCatch(
    fromJSON(text, flatten = TRUE),
    error = function(e) NULL
  )
  if (is.null(parsed)) {                    # fall back to JSONL
    lines <- readLines(path, warn = FALSE)
    lines <- lines[nzchar(trimws(lines))]
    return(json_records_to_dt(lapply(lines, fromJSON)))
  }
  if (is.data.frame(parsed)) return(as.data.table(parsed))
  json_records_to_dt(records_from_response(parsed))
}

#' Fast CSV parsing with data.table::fread. Accepts local paths AND URLs.
#' For very large files, fread streams and memory-maps internally; pass
#' select= to read only some columns.
parse_csv <- function(source, ...) {
  as.data.table(fread(source, showProgress = FALSE, ...))
}

#' Write a data.table to CSV and newline-delimited JSON.
save_outputs <- function(dt, stem, out_dir,
                         formats = c("csv", "json")) {
  dir.create(out_dir, recursive = TRUE, showWarnings = FALSE)
  paths <- character(0)
  if ("csv" %in% formats) {
    p <- file.path(out_dir, sprintf("%s.csv", stem))
    fwrite(dt, p)
    paths <- c(paths, p)
  }
  if ("json" %in% formats) {
    p <- file.path(out_dir, sprintf("%s.json", stem))
    jsonl <- apply(dt, 1, function(row) {
      row <- row[!is.na(row)]
      toJSON(as.list(row), auto_unbox = TRUE)
    })
    writeLines(unname(jsonl), p)
    paths <- c(paths, p)
  }
  for (p in paths) log_info("Wrote %s (%d rows)", p, nrow(dt))
  invisible(paths)
}

# ---------------------------------------------------------------------------
# 4. Batch file downloads
# ---------------------------------------------------------------------------

#' Download many files to local storage.
#'
#' @param files         data.frame (or list of url/path pairs) describing
#'                      what to download and where to store it.
#' @param max_concurrent Parallel workers (unix only; falls back to
#'                      sequential on Windows).
#' @param skip_existing  If TRUE, files already on disk are skipped.
#' @return manifest data.table: url, path, bytes, status, attempts.
batch_download <- function(files,
                           client = make_client(),
                           max_concurrent = 4,
                           skip_existing = TRUE) {
  if (is.data.frame(files)) {
    stopifnot(all(c("url", "path") %in% names(files)))
  } else {
    stopifnot(is.list(files), all(lengths(files) == 2))
    files <- data.table(url = vapply(files, `[[`, "", 1),
                        path = vapply(files, `[[`, "", 2))
  }

  download_one <- function(url, dest) {
    dir.create(dirname(dest), recursive = TRUE, showWarnings = FALSE)
    row <- data.table(url = url, path = dest, bytes = 0, attempts = 1,
                      status = "")
    if (skip_existing && file.exists(dest) && file.info(dest)$size > 0) {
      row$status <- "skipped_existing"
      row$bytes <- file.info(dest)$size
      return(row)
    }
    tryCatch({
      resp <- client$get(url, resp_path = dest)   # inherits retries
      row$status <- "downloaded"
      row$bytes <- file.info(dest)$size
      row
    }, error = function(e) {
      row$status <<- sprintf("error: %s", conditionMessage(e))
      row
    })
  }

  use_parallel <- max_concurrent > 1 &&
    .Platform$OS.type == "unix" && nrow(files) > 1
  rows <- if (use_parallel) {
    parallel::mclapply(seq_len(nrow(files)), function(i)
      download_one(files$url[i], files$path[i]),
      mc.cores = min(max_concurrent, nrow(files)))
  } else {
    lapply(seq_len(nrow(files)), function(i)
      download_one(files$url[i], files$path[i]))
  }
  manifest <- rbindlist(rows, fill = TRUE)
  ok <- manifest$status %in% c("downloaded", "skipped_existing")
  log_info("batch_download: %d/%d succeeded", sum(ok), nrow(manifest))
  manifest
}

# ---------------------------------------------------------------------------
# 5. Demonstration against real public sources (no API key required)
# ---------------------------------------------------------------------------

demo <- function(out_dir) {
  cat(strrep("=", 70), "\n", sep = "")
  cat("Demo 1: page-number pagination - OpenLibrary search API\n")
  cat(strrep("=", 70), "\n", sep = "")
  ol <- make_client("https://openlibrary.org", min_interval = 0.5)
  books <- paginate(ol, "/search.json", style = "page", page_size = 10,
                    max_pages = 2, size_param = "limit",
                    extra_params = list(
                      q = "tolkien",
                      fields = "title,author_name,first_publish_year"))
  df1 <- books[, .(title,
                   author = vapply(author_name, `[`, "", 1),
                   first_publish_year)]
  print(head(df1, 5))
  save_outputs(df1, "openlibrary_tolkien_books", out_dir)

  cat("\n", strrep("=", 70), "\n", sep = "")
  cat("Demo 2: offset/limit pagination - PokeAPI\n")
  cat(strrep("=", 70), "\n", sep = "")
  poke <- make_client("https://pokeapi.co/api/v2", min_interval = 0.5)
  pokemon <- paginate(poke, "/pokemon", style = "offset",
                      page_size = 50, max_pages = 2)
  print(head(pokemon, 5))
  save_outputs(pokemon, "pokeapi_pokemon", out_dir)

  cat("\n", strrep("=", 70), "\n", sep = "")
  cat("Demo 3: link-header pagination - GitHub commits (pandas repo)\n")
  cat(strrep("=", 70), "\n", sep = "")
  gh <- make_client("https://api.github.com", min_interval = 1)
  commits <- paginate(gh, "/repos/pandas-dev/pandas/commits", style = "link",
                      page_size = 25, max_pages = 2)
  df3 <- commits[, .(sha = substr(sha, 1, 12),
                     author = commit.author.name,
                     date = commit.author.date,
                     message = substr(commit.message, 1, 60))]
  print(head(df3, 5))
  save_outputs(df3, "github_pandas_commits", out_dir)

  cat("\n", strrep("=", 70), "\n", sep = "")
  cat("Demo 4: batch download public CSVs, then parse with fread\n")
  cat(strrep("=", 70), "\n", sep = "")
  csv_sources <- data.table(
    url = c("https://raw.githubusercontent.com/cs109/2014_data/master/countries.csv",
            "https://raw.githubusercontent.com/plotly/datasets/master/iris.csv",
            "https://people.sc.fsu.edu/~jburkardt/data/csv/hurricanes.csv",
            "https://people.sc.fsu.edu/~jburkardt/data/csv/addresses.csv"),
    path = file.path(out_dir, "raw", c("countries.csv", "iris.csv",
                                       "hurricanes.csv", "addresses.csv"))
  )
  manifest <- batch_download(csv_sources, max_concurrent = 4)
  print(manifest)
  countries <- parse_csv(file.path(out_dir, "raw", "countries.csv"))
  cat(sprintf("\ncountries.csv -> %d rows, columns: %s\n", nrow(countries),
              paste(names(countries), collapse = ", ")))
  iris_dt <- parse_csv(file.path(out_dir, "raw", "iris.csv"))
  cat(sprintf("iris.csv -> %d rows, columns: %s\n", nrow(iris_dt),
              paste(names(iris_dt), collapse = ", ")))
  hurricanes <- parse_csv(file.path(out_dir, "raw", "hurricanes.csv"))
  cat(sprintf("hurricanes.csv -> %d rows, columns: %s\n", nrow(hurricanes),
              paste(names(hurricanes), collapse = ", ")))

  cat("\n", strrep("=", 70), "\n", sep = "")
  cat("Demo 5: JSON file round-trip (parse what we saved)\n")
  cat(strrep("=", 70), "\n", sep = "")
  rt <- parse_json_file(file.path(out_dir, "github_pandas_commits.json"))
  cat(sprintf("Re-parsed %d commits from saved JSONL\n", nrow(rt)))
  cat("\nAll outputs saved under:", normalizePath(out_dir), "\n")
}

# ---------------------------------------------------------------------------
# CLI entry point
# ---------------------------------------------------------------------------

main <- function(argv = commandArgs(trailingOnly = TRUE)) {
  get_arg <- function(flag, default) {
    i <- match(flag, argv)
    if (!is.na(i) && i < length(argv)) argv[i + 1] else default
  }
  out_dir <- get_arg("--out-dir", "data")
  if ("--verbose" %in% argv) set_log_level("debug")

  demo(out_dir)
  invisible(0)
}

if (sys.nframe() == 0L) {   # running as `Rscript public_data_extractor.R`
  main()
}
