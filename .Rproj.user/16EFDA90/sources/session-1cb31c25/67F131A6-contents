    is.finite(volatility_7d),
    is.finite(log_tx_count_lag1),
    is.finite(log_active_addresses_lag1)
  )

model_2 <- lm(
  volatility_7d ~ log_tx_count_lag1 + log_active_addresses_lag1,
  data = btc_analysis
)

